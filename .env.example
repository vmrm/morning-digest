# Apple ID и app-specific password (НЕ обычный пароль от Apple ID!)
# Создать на: https://appleid.apple.com → Войти и безопасность → Пароли для программ
APPLE_ID=your@icloud.com
APPLE_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Telegram Bot (получить у @BotFather)
TELEGRAM_TOKEN=123456789:AABBCCDDEEFFaabbccddeeff
TELEGRAM_CHAT_ID=123456789

# Часовой пояс. TZ управляет временем cron, TIMEZONE — отображением в дайджесте.
# Держите их одинаковыми.
TZ=Europe/Berlin
TIMEZONE=Europe/Berlin

# Расписание в формате cron (по умолчанию — каждый день в 08:00).
CRON_SCHEDULE=0 8 * * *

# Таймаут запросов к iCloud CalDAV, секунды
CALDAV_TIMEOUT=30
